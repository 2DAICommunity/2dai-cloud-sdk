{
  "name": "2dai-cloud-sdk",
  "version": "2.0.0",
  "description": "Typed JavaScript/TypeScript client for the 2DAI generation API — generate images & video, upload references, and download results with an API key.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "2dai",
    "ai",
    "image-generation",
    "video-generation",
    "generative-ai",
    "sdk",
    "api-client"
  ],
  "license": "MIT",
  "author": "2DAI",
  "homepage": "https://2dai.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2DAICommunity/2dai-cloud-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/2DAICommunity/2dai-cloud-sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
